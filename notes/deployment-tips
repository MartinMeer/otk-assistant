  🎯 **Option 3: Using CI/CD Pipeline (Advanced)**


  **GitHub Actions Deployment**

  Create .github/workflows/deploy.yml:

     1 │name: Deploy to Production
     2 │
     3 │on:
     4 │  push:
     5 │    branches: [ main ]
     6 │
     7 │jobs:
     8 │  deploy:
     9 │    runs-on: ubuntu-latest
    10 │    steps:
    11 │      - uses: actions/checkout@v2
    12 │
    13 │      - name: Deploy to server
    14 │        uses: appleboy/ssh-action@master
    15 │        with:
    16 │          host: ${{ secrets.SERVER_HOST }}
    17 │          username: ${{ secrets.SERVER_USER }}
    18 │          key: ${{ secrets.SSH_PRIVATE_KEY }}
    19 │          script: |
    20 │            cd /opt/otk-assistant
    21 │            git pull origin main
    22 │            docker compose -f docker-compose.prod.yml build
    23 │            docker compose -f docker-compose.prod.yml up -d

