# Production Environment Configuration
# 
# IMPORTANT: 
# 1. Copy this file to .env.prod
# 2. Replace all placeholder values with actual production values
# 3. NEVER commit .env.prod to version control
# 4. Use Docker secrets for sensitive data in production

# =============================================================================
# APPLICATION
# =============================================================================
APP_IMAGE=otk-assistant:latest
SPRING_PROFILES_ACTIVE=production

# JVM Memory Settings
APP_MAX_HEAP=1024m
APP_MIN_HEAP=512m

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_DB=otk
POSTGRES_USER=otkreader
# NOTE: Actual password should be in ./secrets/db_password.txt
POSTGRES_PORT=5432

# Database Backup Settings
BACKUP_RETENTION_DAYS=7

# =============================================================================
# NETWORK & PORTS
# =============================================================================
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# SECURITY & CORS
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API Base URL
API_BASE_URL=https://api.yourdomain.com

# SSL Configuration
SSL_ENABLED=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 
# [ ] Strong database password generated and stored in ./secrets/db_password.txt
# [ ] SSL certificates obtained and placed in ./nginx/ssl/
# [ ] Domain names configured in ALLOWED_ORIGINS and API_BASE_URL
# [ ] Firewall rules configured (only ports 80, 443 exposed)
# [ ] Backup retention policy set (BACKUP_RETENTION_DAYS)
# [ ] Monitoring and alerting configured
# [ ] Log aggregation setup (ELK, CloudWatch, etc.)
# [ ] Resource limits tuned based on load testing
# [ ] Database connection pooling optimized
# [ ] Health check endpoints verified
# [ ] Disaster recovery plan documented
